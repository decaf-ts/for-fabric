#Orchestrators
DOCKER_SOCKET_PATH=/var/run/docker.sock
DEPLOYMENT_PLATFORM=docker
ORG_NAME=orge
LOG_LEVEL=debug

#ORG General Config
ORG__COUNTRY="GB"
ORG__STATE="Greater London"
ORG__LOCALITY="London"
ORG__ORGANIZATION="OrgE Organization"
ORG__ORGANIZATION_UNIT="Fabric for Pharmaledger"

#HSM
HSM__ENABLED=false
HSM__LIB=/usr/lib/softhsm/libsofthsm2.so
HSM__LABEL=orgehsm
HSM__PIN=98765434
HSM__ALT_ID=""
HSM__SO_PIN=1235

#TOOLS
TOOLS__IMAGE=dregistry.pdmfc.com/decaf-ts/fabric-weaver:weaver-2.5.12-latest

#TLS
TLS__PORT=7400
TLS__IMAGE=ghcr.io/pharmaledgerassoc/ptp-infrastructure:fabric-ca-latest
TLS__OPERATIONS_ADDRESS=127.0.0.1:8010
TLS__CSR_HOSTS="0.0.0.0,localhost,127.0.0.1,orge-tls,*.orge.org"
TLS__USER=orge.tls
TLS__SECRET=SomeRandomPassword

#CA
CA__PORT=7410
CA__IMAGE=ghcr.io/pharmaledgerassoc/ptp-infrastructure:fabric-ca-latest
CA__OPERATIONS_ADDRESS=127.0.0.1:8010
CA__CSR_HOSTS="0.0.0.0,localhost,127.0.0.1,orge-ca,*.orge.org"
CA__USER=orge.ca
CA__SECRET=SomeRandomPassword
CA__ADMIN=orge.admin
CA__ADMIN_SECRET=SomeRandomPassword
CA__ADMIN_CSR_HOSTS="0.0.0.0,localhost,127.0.0.1,orge-ca,*.orge.org"


#PEER 0
PEER0__OPERATIONS_ADDRESS=127.0.0.1:8010
PEER0__PORT=7450
PEER0__CHAINCODE_PORT=7460
PEER0__USER=orge.peer0
PEER0__SECRET=SomeRandomPassword
PEER0__COUCHDB_USER=admin
PEER0__COUCHDB_SECRET=adminpw
PEER0__COUCHDB_PORT=7440
PEER0__IMAGE=ghcr.io/pharmaledgerassoc/ptp-infrastructure:fabric-peer-latest
PEER0__COUCHDB_IMAGE=couchdb:latest
PEER0__CSR_HOSTS="0.0.0.0,localhost,127.0.0.1,orge-peer-0,*.orge.org"

#CHANNEL
# CHANNEL__PROFILE=OrgAChannel
CHANNEL__NAME=simple-channel

#CONTRACT
CONTRACT__NAME=simple-chaincode
CONTRACT__USER="orge.ccaas"
CONTRACT__SECRET="SomeRandomPassword"
CONTRACT__IMAGE=ghcr.io/decaf-ts/for-fabric:contract-latest
CONTRACT__PORT=7470
CONTRACT__CSR_HOSTS="0.0.0.0,localhost,127.0.0.1,orge-ccaas-simple-chaincode,*.orge.org"
CONTRACT__VERSION="1.0"
CONTRACT__UPDATE=true

#CONTRACT ON PREM
ON_PREM_CONTRACT__USER="orge.ccaas"
ON_PREM_CONTRACT__SECRET="SomeRandomPassword"
ON_PREM_CONTRACT__NAME=simple-on-prem-chaincode
ON_PREM_CONTRACT__IMAGE=ghcr.io/decaf-ts/for-fabric:contract-latest
ON_PREM_CONTRACT__PORT=7480
ON_PREM_CONTRACT__CSR_HOSTS="0.0.0.0,localhost,127.0.0.1,orge-ccaas-simple-chaincode,*.orge.org"
ON_PREM_CONTRACT__VERSION="1.0"
ON_PREM_CONTRACT__UPDATE=true

PLA__ORG_NAME=orga
PLA__TLS_PORT=7000
PLA__ORDERER_ADDRESS=orga-orderer-0
PLA__ORDERER_PORT=7020
PLA__PEER_ADDRESS=orga-peer-0
PLA__TOOLS_ADDRESS=orga-tools

ENABLE_COLLECTIONS=false
ON_PREM=false

CONTRACT__MAX_RECV_MSG_SIZE=15728640
CONTRACT__MAX_SEND_MSG_SIZE=15728640


# Fabric

FABRIC__CRYPTO_PATH=/docker/docker-data
FABRIC__KEY_CERT_OR_DIRECTORY_PATH=/docker/docker-data/client/msp/keystore
FABRIC__CERT_CERT_OR_DIRECTORY_PATH=/docker/docker-data/client/msp/signcerts
FABRIC__TLS_CERT=/docker/docker-data/tls-cert.pem
FABRIC__PEER_ENDPOINT=orga-peer-0:7050
FABRIC__CA_ENDPOINT=https://orga-ca:7010


### legacy transaction submission cfg
FABRIC__MSP_MAP__ORGAMSP__0__ENDPOINT=orga-peer-0:7050
FABRIC__MSP_MAP__ORGAMSP__0__ALIAS=orga-peer-0
FABRIC__MSP_MAP__ORGAMSP__0__TLS_CERT=/docker/docker-data/pla-peer-0-tls.pem

FABRIC__MSP_MAP__ORGAMSP__1__ENDPOINT=orga-peer-1:7051
FABRIC__MSP_MAP__ORGAMSP__1__ALIAS=orga-peer-1
FABRIC__MSP_MAP__ORGAMSP__1__TLS_CERT=/docker/docker-data/pla-peer-1-tls.pem

FABRIC__MSP_MAP__ORGAMSP__2__ENDPOINT=orga-peer-2:7052
FABRIC__MSP_MAP__ORGAMSP__2__ALIAS=orga-peer-2
FABRIC__MSP_MAP__ORGAMSP__2__TLS_CERT=/docker/docker-data/pla-peer-2-tls.pem
