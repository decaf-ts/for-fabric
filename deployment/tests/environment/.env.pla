#Orchestrators
DOCKER_SOCKET_PATH=/var/run/docker.sock
DEPLOYMENT_PLATFORM=docker
ORG_NAME=orga
LOG_LEVEL=debug

#ORG General Config
ORG__COUNTRY="GB"
ORG__STATE="Greater London"
ORG__LOCALITY="London"
ORG__ORGANIZATION="OrgA Organization"
ORG__ORGANIZATION_UNIT="Fabric for Pharmaledger"

#HSM
HSM__ENABLED=false
HSM__LIB=/usr/lib/softhsm/libsofthsm2.so
HSM__LABEL=orgahsm
HSM__PIN=98765434
HSM__ALT_ID=""
HSM__SO_PIN=1235

#TOOLS
TOOLS__IMAGE=dregistry.pdmfc.com/decaf-ts/fabric-weaver:weaver-2.5.12-latest

#TLS
TLS__PORT=7000
TLS__IMAGE=ghcr.io/pharmaledgerassoc/ptp-infrastructure:fabric-ca-latest
TLS__OPERATIONS_ADDRESS=127.0.0.1:8010
TLS__CSR_HOSTS="0.0.0.0,localhost,127.0.0.1,orga-tls,*.orga.org"
TLS__USER=orga.tls
TLS__SECRET=SomeRandomPassword

#CA
CA__PORT=7010
CA__IMAGE=ghcr.io/pharmaledgerassoc/ptp-infrastructure:fabric-ca-latest
CA__OPERATIONS_ADDRESS=127.0.0.1:8010
CA__CSR_HOSTS="0.0.0.0,localhost,127.0.0.1,orga-ca,*.orga.org"
CA__USER=orga.ca
CA__SECRET=SomeRandomPassword
CA__ADMIN=orga.admin
CA__ADMIN_SECRET=SomeRandomPassword
CA__ADMIN_CSR_HOSTS="0.0.0.0,localhost,127.0.0.1,orga-ca,*.orga.org"

#ORDERER 0
ORDERER0__PORT=7020
ORDERER0__OSN_PORT=7030
ORDERER0__IMAGE=ghcr.io/pharmaledgerassoc/ptp-infrastructure:fabric-orderer-latest
ORDERER0__OPERATIONS_ADDRESS=127.0.0.1:8010
ORDERER0__CSR_HOSTS="0.0.0.0,localhost,127.0.0.1,orga-orderer-0,*.orga.org"
ORDERER0__USER=orga.orderer0
ORDERER0__SECRET=SomeRandomPassword

#ORDERER 1
ORDERER1__PORT=7021
ORDERER1__OSN_PORT=7031
ORDERER1__IMAGE=ghcr.io/pharmaledgerassoc/ptp-infrastructure:fabric-orderer-latest
ORDERER1__OPERATIONS_ADDRESS=127.0.0.1:8010
ORDERER1__CSR_HOSTS="0.0.0.0,localhost,127.0.0.1,orga-orderer-1,*.orga.org"
ORDERER1__USER=orga.orderer1
ORDERER1__SECRET=SomeRandomPassword

#ORDERER 2
ORDERER2__PORT=7022
ORDERER2__OSN_PORT=7032
ORDERER2__IMAGE=ghcr.io/pharmaledgerassoc/ptp-infrastructure:fabric-orderer-latest
ORDERER2__OPERATIONS_ADDRESS=127.0.0.1:8010
ORDERER2__CSR_HOSTS="0.0.0.0,localhost,127.0.0.1,orga-orderer-2,*.orga.org"
ORDERER2__USER=orga.orderer2
ORDERER2__SECRET=SomeRandomPassword

#PEER 0
PEER0__OPERATIONS_ADDRESS=127.0.0.1:8010
PEER0__PORT=7050
PEER0__CHAINCODE_PORT=7060
PEER0__USER=orga.peer0
PEER0__SECRET=SomeRandomPassword
PEER0__COUCHDB_USER=admin
PEER0__COUCHDB_SECRET=adminpw
PEER0__COUCHDB_PORT=7040
PEER0__IMAGE=ghcr.io/pharmaledgerassoc/ptp-infrastructure:fabric-peer-latest
PEER0__COUCHDB_IMAGE=couchdb:latest
PEER0__CSR_HOSTS="0.0.0.0,localhost,127.0.0.1,orga-peer-0,*.orga.org"

#PEER 1
PEER1__OPERATIONS_ADDRESS=127.0.0.1:8010
PEER1__PORT=7051
PEER1__CHAINCODE_PORT=7061
PEER1__USER=orga.peer1
PEER1__SECRET=SomeRandomPassword
PEER1__COUCHDB_USER=admin
PEER1__COUCHDB_SECRET=adminpw
PEER1__COUCHDB_PORT=7041
PEER1__IMAGE=ghcr.io/pharmaledgerassoc/ptp-infrastructure:fabric-peer-latest
PEER1__COUCHDB_IMAGE=couchdb:latest
PEER1__CSR_HOSTS="0.0.0.0,localhost,127.0.0.1,orga-peer-1,*.orga.org"

#PEER 2
PEER2__OPERATIONS_ADDRESS=127.0.0.1:8010
PEER2__PORT=7052
PEER2__CHAINCODE_PORT=7062
PEER2__USER=orga.peer2
PEER2__SECRET=SomeRandomPassword
PEER2__COUCHDB_USER=admin
PEER2__COUCHDB_SECRET=adminpw
PEER2__COUCHDB_PORT=7042
PEER2__IMAGE=ghcr.io/pharmaledgerassoc/ptp-infrastructure:fabric-peer-latest
PEER2__COUCHDB_IMAGE=couchdb:latest
PEER2__CSR_HOSTS="0.0.0.0,localhost,127.0.0.1,orga-peer-2,*.orga.org"


#CHANNEL
CHANNEL__PROFILE=OrgAChannel
CHANNEL__NAME=simple-channel

ON_PREM_CHANNEL__PROFILE=OrgAOnPremChannel
ON_PREM_CHANNEL__NAME=simple-on-prem-channel

#CONTRACT
CONTRACT__NAME=simple-chaincode
CONTRACT__USER="orga.ccaas"
CONTRACT__SECRET="SomeRandomPassword"
CONTRACT__IMAGE=ghcr.io/pharmaledgerassoc/ptp-toolkit:contract-latest
CONTRACT__PORT=7070
CONTRACT__CSR_HOSTS="0.0.0.0,localhost,127.0.0.1,orga-ccaas-simple-chaincode,orga-ccaas-simple-on-prem-chaincode,*.orga.org"
CONTRACT__TAG=latest
CONTRACT__VERSION="1.0"

ON_PREM_CONTRACT__NAME=simple-on-prem-chaincode
ON_PREM_CONTRACT__USER="orga.ccaas"
ON_PREM_CONTRACT__SECRET="SomeRandomPassword"
ON_PREM_CONTRACT__IMAGE=ghcr.io/pharmaledgerassoc/ptp-toolkit:contract-latest
ON_PREM_CONTRACT__PORT=7080
ON_PREM_CONTRACT__CSR_HOSTS="0.0.0.0,localhost,127.0.0.1,orga-ccaas-simple-chaincode,*.orga.org"
ON_PREM_CONTRACT__TAG=latest
ON_PREM_CONTRACT__VERSION="1.0"

ENABLE_COLLECTIONS=false
PARTICIPATING_ORGS=orgc


CONTRACT__MAX_RECV_MSG_SIZE=15728640        
CONTRACT__MAX_SEND_MSG_SIZE=15728640